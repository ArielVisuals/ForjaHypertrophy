---
import MainLayout from "@/layouts/MainLayout.astro";
import { SettingsPanel } from "@/components/shared/SettingsPanel";
import ProfileEditor from "@/components/social/ProfileEditor";
import FriendSystem from "@/components/social/FriendSystem";
import { db } from "@/lib/db";
import { users, nutritionTargets } from "@/lib/db/schema";
import { eq, and } from "drizzle-orm";
import { getActiveMealPlan } from "@/lib/db/mealPlans";

const userId = Astro.locals.user?.id ?? null;
if (!userId) return Astro.redirect("/");

const mealPlan = await getActiveMealPlan(userId);

const [target] = await db
  .select()
  .from(nutritionTargets)
  .where(and(eq(nutritionTargets.userId, userId), eq(nutritionTargets.active, true)))
  .limit(1);

// Datos del perfil actual
const [currentUser] = await db
  .select({ displayName: users.displayName, username: users.username, avatarUrl: users.avatarUrl, bio: users.bio })
  .from(users)
  .where(eq(users.id, userId))
  .limit(1);

const cloudName = import.meta.env.CLOUDINARY_CLOUD_NAME ?? "";
const uploadPreset = import.meta.env.CLOUDINARY_UPLOAD_PRESET ?? "forja_avatars";
---

<MainLayout title="Configuración" description="Ajustes de cuenta, preferencias de la aplicación y configuración personal de FORJA.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-10 space-y-12">

    <!-- Header -->
    <div class="mb-8 md:mb-12">
      <p class="text-[9px] font-black text-blue-500/40 uppercase tracking-[0.4em] mb-1 hidden sm:block">FORJA / CONFIGURACIÓN</p>
      <h1 class="text-3xl sm:text-4xl font-black text-white uppercase tracking-tighter leading-none">PERFIL Y METAS</h1>
      <p class="text-white/25 text-xs font-bold uppercase tracking-widest mt-2">Personaliza tu identidad y tus objetivos</p>
    </div>

    <!-- ─── Sección: Tu Perfil ──────────────────────────────────────────── -->
    <section>
      <div class="mb-6">
        <p class="text-[9px] font-black text-blue-500/50 uppercase tracking-[0.4em] mb-1">Identidad</p>
        <h2 class="text-xl font-black text-white uppercase tracking-tight">Tu Perfil</h2>
        <p class="text-white/25 text-xs font-medium mt-1">Tu foto de perfil y username son visibles para tus amigos en FORJA</p>
      </div>
      <div class="rounded-2xl p-6" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06);">
        <ProfileEditor
          currentAvatarUrl={currentUser?.avatarUrl}
          displayName={currentUser?.displayName}
          currentUsername={currentUser?.username}
          currentBio={currentUser?.bio}
          cloudName={cloudName}
          uploadPreset={uploadPreset}
          client:load
        />
      </div>
    </section>

    <!-- ─── Sección: Amigos ─────────────────────────────────────────────── -->
    <section>
      <div class="mb-6">
        <p class="text-[9px] font-black text-blue-500/50 uppercase tracking-[0.4em] mb-1">Social</p>
        <h2 class="text-xl font-black text-white uppercase tracking-tight">Amigos</h2>
        <p class="text-white/25 text-xs font-medium mt-1">Conecta con tus compañeros de entrenamiento y comparte tus récords</p>
      </div>
      <div class="rounded-2xl p-6" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06);">
        <FriendSystem client:load />
      </div>
    </section>

    <!-- ─── Sección: Nutrición / Metas ─────────────────────────────────── -->
    <section>
      <div class="mb-6">
        <p class="text-[9px] font-black text-blue-500/50 uppercase tracking-[0.4em] mb-1">Nutrición</p>
        <h2 class="text-xl font-black text-white uppercase tracking-tight">Metas Calóricas</h2>
        <p class="text-white/25 text-xs font-medium mt-1">Calcula tus calorías y macros óptimos según tu objetivo</p>
      </div>
      {userId && (
        <SettingsPanel
          userId={userId}
          lockedByPlan={mealPlan?.name ?? null}
          initialTargets={target ? {
            calories: Number(target.calories),
            proteinG: Number(target.proteinG),
            carbsG:   Number(target.carbsG),
            fatsG:    Number(target.fatsG),
          } : null}
          client:load
        />
      )}
    </section>

  </div>
</MainLayout>
